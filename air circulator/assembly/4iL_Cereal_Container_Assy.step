ISO-10303-21;
HEADER;
/* Generated by software containing ST-Developer
 * from STEP Tools, Inc. (www.steptools.com) 
 */

FILE_DESCRIPTION(
/* description */ (
'&lt;p&gt;This is a 3D Model of a 4L Cereal Container to aid fellow ma
kers with designing accessories, desiccant trays, etc. to fit with it.
 \X\A0Specifically, it is the Sorbus 4L Container found &lt;a target=&
amp;#34;_blank&amp;#34; rel=&amp;#34;noopener noreferrer ugc&amp;#34; 
href=&amp;#34;https://www.homedepot.com/p/Sorbus-Airtight-Food-Storage
-Dispensers-for-Beans-Pasta-Cereals-and-More-6-Pack-4-L-16-9-Cups-GS-C
R6/333689761&amp;#34;&gt;HERE&lt;/a&gt;, but after looking at many I b
elieve they are all very close. \X\A0I wouldn&amp;#39;t be surprised i
f several of them use the exact same molds. \X\A0Even if your dimensio
ns don&amp;#39;t match exactly, this should give you a good starting p
oint.&lt;/p&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt;&lt;p&gt;To download the m
odel, use the dropdown menu above and select \X2\201C\X0\Download STL/
CAD Files\X2\201D\X0\.&lt;/p&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt;&lt;figur
e class=&amp;#34;image image_resized&amp;#34; style=&amp;#34;height: a
uto; width: 353.304px&amp;#34;&gt;&lt;img src=&amp;#34;https://makerwo
rld.bblmw.com/makerworld/model/DSM00000001458083/design/2025-04-03_667
5c3ddd11ff.png&amp;#34;&gt;&lt;/figure&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt
;&lt;p&gt;It is an unofficial model I created myself by taking measure
ments. \X\A0I didn&amp;#39;t model the seals just the plastic parts. \X\A0
Some of the more complicated non-consequential parts like the hinge an
d the top of the grip I had to rough it in. \X\A0While most of it is v
ery accurate and I took a lot of time and care taking the measurements
, there may be an occasional mistake. \X\A0Please let me know and I wi
ll try to fix it. \X\A0&lt;/p&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt;&lt;p&gt
;Always verify anything critical with whatever container you are using.
&lt;/p&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt;&lt;p&gt;Update - Added scaled 
down print profile in case you want it.&lt;/p&gt;&lt;boostme&gt;&lt;bo
osttitle&gt;Boost Me&lt;/boosttitle&gt;&lt;boostcontent&gt;If it helps
 you and you want to give me a boost, it is always appreciated.&lt;/bo
ostcontent&gt;&lt;/boostme&gt;'),
/* implementation_level */ '2;1');

FILE_NAME(
/* name */ '4iL_Cereal_Container_Assy.step',
/* time_stamp */ '2026-08-15T14:35:34+05:30',
/* author */ (''),
/* organization */ (''),
/* preprocessor_version */ 'ST-DEVELOPER v20.1',
/* originating_system */ 'Autodesk Translation Framework v15.8.0.0',
/* authorisation */ '');

FILE_SCHEMA (('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;

